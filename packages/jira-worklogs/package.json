{
  "name": "@westwall/dsh-jira-worklogs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Jira 工时记录（草稿）：月历缺口、日详情、Git 素材，生成并提交工时记录。",
  "icon": "./icon.svg",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.2-rc.2"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test 'tests/**/*.test.{ts,mjs}'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "undici": "^8.11.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/cordis-plugin-loader": "^1.1.0",
    "@deepseek-ai/dsh-error": "0.2.2-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.2",
    "@deepseek-ai/dsh-storage": "0.2.2-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.2",
    "@deepseek-ai/dsh-storage-json": "0.2.2-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.2",
    "@deepseek-ai/schemastery": "^3.19.0",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/cordis-plugin-loader": "^1.1.0",
    "@deepseek-ai/dsh": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc <0.3.0",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc <0.3.0",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.0-rc <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc <0.3.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.0-rc <0.3.0",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "files": [
    "lib",
    "src",
    "client",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "docs"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
