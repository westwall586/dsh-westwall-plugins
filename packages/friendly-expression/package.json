{
  "name": "@westwall/dsh-friendly-expression",
  "version": "0.1.0",
  "description": "友好表达：可编辑的受控表达约束 Agent 的措辞与结构，并把 Mermaid 围栏渲染成可缩放的图。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/westwall586/dsh-westwall-plugins.git",
    "directory": "packages/friendly-expression"
  },
  "homepage": "https://github.com/westwall586/dsh-westwall-plugins/tree/main/packages/friendly-expression#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mermaid",
    "diagram",
    "prompt",
    "tone",
    "expression"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.2-rc.2"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node tools/build-client.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p client/tsconfig.json",
    "test": "node --test 'test/**/*.test.ts'"
  },
  "dependencies": {
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.2",
    "@deepseek-ai/schemastery": "^3.19.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "esbuild": "^0.25.0",
    "mermaid": "11.15.0",
    "typescript": "~5.9.3"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "docs",
    "icon-180.png",
    "icon-512.png",
    "assets",
    "screenshots.json"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.2-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  }
}
