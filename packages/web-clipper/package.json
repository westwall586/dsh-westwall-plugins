{
  "name": "@westwall/dsh-web-clipper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "网页剪藏（草稿）：把侧栏浏览器里的当前网页作为 Markdown 附件加进当前会话，交给 Agent 阅读。",
  "icon": "./icon.svg",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src",
    "client",
    "client.js",
    "tools",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "docs"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.2-rc.2"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node tools/build.mjs && node --test 'test/**/*.test.mjs'",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "defuddle": "0.19.4",
    "esbuild": "^0.25.0",
    "linkedom": "^0.18.13",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.2-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}