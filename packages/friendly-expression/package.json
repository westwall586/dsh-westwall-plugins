{
  "name": "@westwall/dsh-friendly-expression",
  "version": "0.0.1",
  "private": true,
  "description": "友好表达：可编辑的表达提示词，加上 Mermaid 等表达形态的渲染（设计阶段，尚未实现）。",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.2-rc.2"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/**/*.test.ts'"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "docs"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.2-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  }
}
